# Copy this file to .env, then replace values that differ on your machine.
# Spring Boot loads it automatically when run from the backend directory.

DB_URL=jdbc:postgresql://localhost:5432/home_inventory
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgres-password
PHOTO_STORAGE_LOCATION=uploads
DDL_AUTO=update

# Create an OAuth 2.0 Web application in Google Cloud Console. Its redirect URI is:
# http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Bootstrap account(s) allowed to create the first household. Once one exists,
# every additional account must be invited from the Household page.
APP_AUTH_ALLOWED_EMAILS=you@example.com
# Development bootstrap only: let the first verified Google account create the household.
# This never lets uninvited accounts join an existing household.
APP_AUTH_ALLOW_ALL=false
FRONTEND_URL=http://localhost:5173

# Local HTTP development defaults. Production must use secure=true. Use same-site=none
# only when frontend and backend are on different sites; it also requires HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
