# Copy this file to .env, then replace values that differ on your machine.
# Spring Boot loads it automatically when run from the backend directory.

DB_URL=jdbc:postgresql://localhost:5432/home_inventory
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgres-password
PHOTO_STORAGE_LOCATION=uploads
DDL_AUTO=update

# Create an OAuth 2.0 Web application in Google Cloud Console. Its redirect URI is:
# http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

FRONTEND_URL=http://localhost:5173

# Local HTTP development defaults. For a Vercel frontend + Render backend, set
# SESSION_COOKIE_SECURE=true and SESSION_COOKIE_SAME_SITE=none in Render.
# SameSite=None requires HTTPS, which Render provides.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
